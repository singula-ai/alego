{
  "name": "@singula-ai/alego-api-gateway",
  "description": "Typert Remote Host dispatcher and Client API endpoint",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/api/gateway"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "node": "./lib/client.node.js",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.browser.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./stream-protocol": {
      "types": "./lib/types/stream-protocol.d.ts",
      "default": "./lib/types/stream-protocol.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "alego": {
    "client": {
      "inject": [
        "@singula-ai/alego-typert-registry",
        "@singula-ai/alego-client-connection"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.browser.js",
    "lib/client.node.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@singula-ai/alego-deque": "workspace:*",
    "@singula-ai/alego-timeout": "workspace:*",
    "@singula-ai/schemastery": "workspace:~",
    "ws": "^8.21.3",
    "@singula-ai/alego-typert-protocol": "workspace:*"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@singula-ai/alego-api-remote-access": "workspace:*",
    "@singula-ai/alego-brand": "workspace:*",
    "@singula-ai/alego-cmdline": "workspace:*",
    "@singula-ai/alego-client-connection": "workspace:*",
    "@singula-ai/alego-host-webserver": "workspace:*",
    "@singula-ai/alego-remote-mock": "workspace:*",
    "@singula-ai/alego-typert-registry": "workspace:*",
    "@singula-ai/alego-util-crypto": "workspace:*",
    "@types/ws": "^8.18.1",
    "@singula-ai/cordis": "workspace:~",
    "zod": "4.4.3"
  }
}
