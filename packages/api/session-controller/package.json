    "@singula-ai/alego-typert-protocol": "workspace:^",
    "@singula-ai/alego-typert-registry": "workspace:^",
    "@singula-ai/alego-util-time": "workspace:^",
    "@singula-ai/alego-util-workspace-path": "workspace:^",
    "@singula-ai/alego-workspace": "workspace:^"
  },
  "peerDependenciesMeta": {
