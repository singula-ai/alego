    "@singula-ai/alego-commands": "workspace:^",
    "@singula-ai/alego-file-reference": "workspace:^",
    "@singula-ai/alego-jobs": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-native-command": "workspace:^",
    "@singula-ai/alego-scope": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-session-persistence": "workspace:^",
    "@singula-ai/alego-session-projection": "workspace:^",
    "@singula-ai/alego-session-projection-cache": "workspace:^",
    "@singula-ai/alego-session-query": "workspace:^",
    "@singula-ai/alego-session-title": "workspace:^",
    "@singula-ai/alego-skill": "workspace:^",
