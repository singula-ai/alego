    "@alego/invariants": "workspace:^",
    "@alego/llm": "workspace:^",
    "@alego/session": "workspace:^",
    "@alego/session-persistence": "workspace:^",
    "@alego/subagent": "workspace:^",
    "@alego/tools": "workspace:^",
    "@alego/cordis": "workspace:^"
  },
  "devDependencies": {
    "@alego/agent": "workspace:^",
    "@alego/agent-loop": "workspace:^",
    "@alego/agent-loop-testkit": "workspace:^",
    "@alego/shell": "workspace:^",
    "@alego/bash-local": "workspace:^",
    "@alego/subprocess-local": "workspace:^",
    "@alego/hook-protocol": "workspace:^",
    "@alego/invariants": "workspace:^",
    "@alego/llm": "workspace:^",
    "@alego/session": "workspace:^",
    "@alego/session-persistence": "workspace:^",
    "@alego/session-persistence-jsonl": "workspace:^",
    "@alego/subagent": "workspace:^",
    "@alego/tools": "workspace:^",
    "@alego/cordis": "workspace:^"
  }
