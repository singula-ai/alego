{
  "name": "@singula-ai/alego-workspace-changes",
  "description": "Per-turn workspace file changes recorded from git working-tree snapshots and whole-file captures, with per-file comparisons, for the Alego",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/deliverables/workspace-changes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@singula-ai/schemastery": "workspace:~",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/alego-tools": "workspace:*",
    "@singula-ai/alego-fs": "workspace:*"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/cordis-plugin-include": "workspace:~",
    "@singula-ai/cordis-plugin-loader": "workspace:~",
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/alego-subprocess-local": "workspace:*",
    "@singula-ai/alego-tools": "workspace:*",
    "@singula-ai/alego-llm": "workspace:*",
    "@singula-ai/alego-fs": "workspace:*",
    "@singula-ai/alego-fs-local": "workspace:*",
    "@singula-ai/alego-agent-loop-testkit": "workspace:*",
    "@singula-ai/alego-agent-loop": "workspace:*",
    "@singula-ai/alego-working-directory": "workspace:*",
    "@singula-ai/alego-tool-fs": "workspace:*",
    "@singula-ai/alego-tool-str-replace-editor": "workspace:*"
  }
}
