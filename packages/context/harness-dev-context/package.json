{
  "name": "@singula-ai/alego-harness-dev-context",
  "description": "Model context naming the Alego checkout and Web GUI URL without letting either change the system prompt",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/context/harness-dev-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-session-projection": "workspace:*",
    "@singula-ai/alego-system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-agent-loop-testkit": "workspace:*",
    "@singula-ai/alego-llm": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-session-projection": "workspace:*",
    "@singula-ai/alego-system-prompt": "workspace:*",
    "@singula-ai/alego-web-app": "workspace:*"
  }
}
