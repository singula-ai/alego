{
  "name": "@singula-ai/alego-agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-fs": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-home-paths": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@singula-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis-plugin-loader": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-agent-loop": "workspace:^",
    "@singula-ai/alego-fs": "workspace:^",
    "@singula-ai/alego-fs-local": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-llm-deepseek": "workspace:^",
    "@singula-ai/alego-home-paths": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-system-prompt": "workspace:^",
    "@singula-ai/alego-tool-fs": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  }
}
