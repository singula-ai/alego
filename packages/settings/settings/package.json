{
  "name": "@singula-ai/alego-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Alego",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-brand": "workspace:*",
    "@singula-ai/alego-invariants": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-brand": "workspace:*",
    "@singula-ai/alego-invariants": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/schemastery": "workspace:~",
    "@singula-ai/cordis-plugin-timer": "workspace:~",
    "@singula-ai/alego-app-boot": "workspace:*",
    "@singula-ai/alego-hmr": "workspace:*",
    "@singula-ai/alego-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@singula-ai/alego-util-values": "workspace:*",
    "@singula-ai/alego-config-editor": "workspace:*",
    "@singula-ai/cordis-plugin-loader": "workspace:~",
    "@singula-ai/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
