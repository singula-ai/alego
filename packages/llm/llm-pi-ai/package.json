{
  "name": "@alego/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Alego LLM seam (design-verification twin of alego-llm-deepseek)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@alego/attachment": "workspace:^",
    "@alego/authorization": "workspace:^",
    "@alego/credentials": "workspace:^",
    "@alego/launch-environment": "workspace:^",
    "@alego/invariants": "workspace:^",
    "@alego/llm": "workspace:^",
    "@alego/settings": "workspace:^",
    "@alego/timeout": "workspace:^",
    "@alego/cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@alego/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@alego/attachment": "workspace:^",
    "@alego/authorization": "workspace:^",
    "@alego/credentials": "workspace:^",
    "@alego/launch-environment": "workspace:^",
    "@alego/invariants": "workspace:^",
    "@alego/llm": "workspace:^",
    "@alego/llm-deepseek": "workspace:^",
    "@alego/settings": "workspace:^",
    "@alego/timeout": "workspace:^",
    "@alego/cordis": "workspace:^"
  }
}
