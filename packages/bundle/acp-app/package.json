{
  "name": "@singula-ai/alego-acp-app",
  "description": "The alego ACP profile bundle: automation-only JSON-RPC stdio and process lifecycle over alego-base",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/bundle/acp-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "alego": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@singula-ai/alego-acp": "workspace:^",
    "@singula-ai/alego-cmdline": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis-plugin-include": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  }
}
