{
  "name": "@singula-ai/alego-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, editor, and JSONL sessions",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "alego": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@singula-ai/cordis-plugin-timer": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-agent-loop": "workspace:^",
    "@singula-ai/alego-deepseek-llm-api-extensions": "workspace:^",
    "@singula-ai/alego-fs-local": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-jobs-local": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-llm-deepseek": "workspace:^",
    "@singula-ai/alego-llm-retry": "workspace:^",
    "@singula-ai/alego-plugin-package-inventory-deepseek": "workspace:^",
    "@singula-ai/alego-sandbox-local": "workspace:^",
    "@singula-ai/alego-sandbox-policy": "workspace:^",
    "@singula-ai/alego-scope": "workspace:^",
    "@singula-ai/alego-sdk-app": "workspace:^",
    "@singula-ai/alego-sdk-jsonrpc-server": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-session-log-deepseek": "workspace:^",
    "@singula-ai/alego-session-persistence-jsonl": "workspace:^",
    "@singula-ai/alego-session-projection": "workspace:^",
    "@singula-ai/alego-session-title": "workspace:^",
    "@singula-ai/alego-subprocess-local": "workspace:^",
    "@singula-ai/alego-system-prompt": "workspace:^",
    "@singula-ai/alego-terminal": "workspace:^",
    "@singula-ai/alego-terminal-bash": "workspace:^",
    "@singula-ai/alego-tool-bash-persistent": "workspace:^",
    "@singula-ai/alego-tool-pwsh-persistent": "workspace:^",
    "@singula-ai/alego-tool-str-replace-editor": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^"
  }
}
