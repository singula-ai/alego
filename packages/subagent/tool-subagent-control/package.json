    "directory": "packages/subagent/tool-subagent-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./list-agents": {
      "types": "./lib/types/list-agents.d.ts",
      "default": "./lib/types/list-agents.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-subagent": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-agent-loop": "workspace:^",
    "@singula-ai/alego-agent-loop-testkit": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-session-persistence": "workspace:^",
    "@singula-ai/alego-session-persistence-jsonl": "workspace:^",
    "@singula-ai/alego-session-projection": "workspace:^",
    "@singula-ai/alego-session-query": "workspace:^",
    "@singula-ai/alego-subagent": "workspace:^",
    "@singula-ai/alego-subagent-fork-in-process": "workspace:^",
    "@singula-ai/alego-subagent-spawn-in-process": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^"
  },
  "dependencies": {
    "@singula-ai/alego-brand": "workspace:^",
    "@singula-ai/alego-util-values": "workspace:^"
  }
