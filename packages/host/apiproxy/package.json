{
  "name": "@alego/host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@alego/attachment": "workspace:^",
    "@alego/agent": "workspace:^",
    "@alego/agent-default-model": "workspace:^",
    "@alego/api-remotes": "workspace:^",
    "@alego/brand": "workspace:^",
    "@alego/commands": "workspace:^",
    "@alego/credentials": "workspace:^",
    "@alego/goal": "workspace:^",
    "@alego/host-directory-picker": "workspace:^",
    "@alego/llm": "workspace:^",
    "@alego/native-command": "workspace:^",
    "@alego/session": "workspace:^",
    "@alego/session-persistence": "workspace:^",
    "@alego/session-projection": "workspace:^",
    "@alego/session-projection-cache": "workspace:^",
    "@alego/session-query": "workspace:^",
    "@alego/session-title": "workspace:^",
    "@alego/settings": "workspace:^",
    "@alego/skill": "workspace:^",
    "@alego/subagent": "workspace:^",
    "@alego/jobs": "workspace:^",
    "@alego/tools": "workspace:^",
    "@alego/user-approval": "workspace:^",
    "@alego/user-questions": "workspace:^",
    "@alego/workspace": "workspace:^",
    "@alego/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@alego/cordis": "workspace:^",
    "@alego/agent-presets": "workspace:^",
    "@alego/cordis-host-runner": "workspace:^",
    "@alego/invariants": "workspace:^"
  },
  "devDependencies": {
    "@alego/cordis": "workspace:^",
    "@alego/agent-presets": "workspace:^",
    "@alego/cordis-host-runner": "workspace:^",
    "@alego/invariants": "workspace:^",
    "@alego/storage": "workspace:^",
    "@alego/storage-domain": "workspace:^",
    "@alego/typert-protocol": "workspace:^",
    "@alego/typert-registry": "workspace:^",
    "@alego/cordis": "workspace:^"
  }
}
