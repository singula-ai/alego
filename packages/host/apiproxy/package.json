{
  "name": "@singula-ai/alego-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@singula-ai/alego-attachment": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-agent-default-model": "workspace:^",
    "@singula-ai/alego-api-remotes": "workspace:^",
    "@singula-ai/alego-brand": "workspace:^",
    "@singula-ai/alego-commands": "workspace:^",
    "@singula-ai/alego-credentials": "workspace:^",
    "@singula-ai/alego-goal": "workspace:^",
    "@singula-ai/alego-host-directory-picker": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-native-command": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-session-persistence": "workspace:^",
    "@singula-ai/alego-session-projection": "workspace:^",
    "@singula-ai/alego-session-projection-cache": "workspace:^",
    "@singula-ai/alego-session-query": "workspace:^",
    "@singula-ai/alego-session-title": "workspace:^",
    "@singula-ai/alego-settings": "workspace:^",
    "@singula-ai/alego-skill": "workspace:^",
    "@singula-ai/alego-subagent": "workspace:^",
    "@singula-ai/alego-jobs": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/alego-user-approval": "workspace:^",
    "@singula-ai/alego-user-questions": "workspace:^",
    "@singula-ai/alego-workspace": "workspace:^",
    "@singula-ai/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-agent-presets": "workspace:^",
    "@singula-ai/alego-cordis-host-runner": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-agent-presets": "workspace:^",
    "@singula-ai/alego-cordis-host-runner": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-storage": "workspace:^",
    "@singula-ai/alego-storage-domain": "workspace:^",
    "@singula-ai/alego-typert-protocol": "workspace:^",
    "@singula-ai/alego-typert-registry": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  }
}
