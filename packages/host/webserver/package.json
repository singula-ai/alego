{
  "name": "@singula-ai/alego-host-webserver",
  "description": "Web route-registration plugin: HTTP and upgrade routes, index transform taps, and static dist fallback; knows no harness concepts",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/host/webserver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@singula-ai/schemastery": "workspace:~",
    "compression": "^1.8.1",
    "ipaddr.js": "^2.5.0",
    "negotiator": "^1.1.0"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@types/compression": "^1.8.1",
    "@types/negotiator": "^0.6.5",
    "selfsigned": "^4.0.1"
  }
}
