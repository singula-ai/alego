{
  "name": "@singula-ai/alego-host-directory-picker-auto",
  "description": "Adaptive chooser of the directory-picker seam: resolves the host situation at boot and mounts the native or browse backend for the Alego web GUI host",
  "version": "0.1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/host/directory-picker-auto"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/cordis-plugin-loader": "workspace:^",
    "@singula-ai/alego-client-ui-directory-picker-browse": "workspace:^",
    "@singula-ai/alego-client-ui-directory-picker-native": "workspace:^",
    "@singula-ai/alego-host-directory-picker-browse": "workspace:^",
    "@singula-ai/alego-host-directory-picker-native": "workspace:^",
    "@singula-ai/alego-host-webserver": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/cordis-plugin-include": "workspace:^",
    "@singula-ai/cordis-plugin-loader": "workspace:^",
    "@singula-ai/alego-client-ui-directory-picker-browse": "workspace:^",
    "@singula-ai/alego-client-ui-directory-picker-native": "workspace:^",
    "@singula-ai/alego-host-directory-picker": "workspace:^",
    "@singula-ai/alego-host-directory-picker-browse": "workspace:^",
    "@singula-ai/alego-host-directory-picker-native": "workspace:^",
    "@singula-ai/alego-host-webserver": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^"
  }
}
