{
  "name": "@singula-ai/alego-host-open-in-app",
  "description": "Host half of open-in-app: resolved application catalog, icons, and the launch endpoint as three webServer routes",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/host/open-in-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./lib/types/shared.d.ts",
      "default": "./lib/types/shared.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@singula-ai/alego-launch-environment": "workspace:^",
    "@singula-ai/alego-native-command": "workspace:^",
    "@singula-ai/alego-subprocess": "workspace:^",
    "@singula-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/cordis-plugin-loader": "workspace:^",
    "@singula-ai/alego-host-webserver": "workspace:^"
  }
}
