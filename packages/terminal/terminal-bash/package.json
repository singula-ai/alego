{
  "name": "@singula-ai/alego-terminal-bash",
  "description": "Persistent shell PTY backend over the Alego subprocess terminal primitive",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-terminal": "workspace:*",
    "@singula-ai/alego-sandbox": "workspace:*",
    "@singula-ai/alego-sandbox-policy": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-session-projection": "workspace:*",
    "@singula-ai/alego-working-directory": "workspace:*"
  },
  "dependencies": {
    "@singula-ai/alego-lazy-require": "workspace:*",
    "@singula-ai/alego-pwsh-local": "workspace:*",
    "@singula-ai/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-agent-loop-testkit": "workspace:*",
    "@singula-ai/alego-terminal": "workspace:*",
    "@singula-ai/alego-sandbox": "workspace:*",
    "@singula-ai/alego-sandbox-policy": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/alego-subprocess-local": "workspace:*",
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-working-directory": "workspace:*"
  }
}
