{
  "name": "@singula-ai/alego-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@singula-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-terminal": "workspace:^",
    "@singula-ai/alego-output-retention": "workspace:^",
    "@singula-ai/alego-system-prompt": "workspace:^",
    "@singula-ai/alego-jobs": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis-plugin-include": "workspace:^",
    "@singula-ai/cordis-plugin-loader": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-terminal": "workspace:^",
    "@singula-ai/alego-terminal-bash": "workspace:^",
    "@singula-ai/alego-output-retention": "workspace:^",
    "@singula-ai/alego-sandbox": "workspace:^",
    "@singula-ai/alego-sandbox-policy": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-subprocess-local": "workspace:^",
    "@singula-ai/alego-system-prompt": "workspace:^",
    "@singula-ai/alego-jobs": "workspace:^",
    "@singula-ai/alego-jobs-local": "workspace:^",
    "@singula-ai/alego-tool-jobs": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  }
}
