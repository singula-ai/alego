{
  "name": "@singula-ai/alego-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/alego-attachment": "workspace:*",
    "@singula-ai/alego-llm": "workspace:*",
    "@singula-ai/alego-scope": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/alego-timeout": "workspace:*",
    "@singula-ai/alego-tools": "workspace:*",
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-mcp-resources": "workspace:*",
    "@singula-ai/alego-system-prompt": "workspace:*"
  },
  "dependencies": {
    "@singula-ai/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.0.0",
    "@singula-ai/alego-util-values": "workspace:*"
  },
  "devDependencies": {
    "@singula-ai/alego-attachment": "workspace:*",
    "@singula-ai/alego-attachment-local": "workspace:*",
    "@singula-ai/alego-llm": "workspace:*",
    "@singula-ai/alego-scope": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/alego-timeout": "workspace:*",
    "@singula-ai/alego-tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.7.4",
    "@modelcontextprotocol/server-filesystem": "^2026.7.4",
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "^4.4.3",
    "@singula-ai/alego-mcp-resources": "workspace:*",
    "@singula-ai/alego-system-prompt": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@singula-ai/alego-mcp-resources": {
      "optional": true
    },
    "@singula-ai/alego-system-prompt": {
      "optional": true
    }
  }
