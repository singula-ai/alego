{
  "name": "@singula-ai/alego-storage-domain",
  "description": "Domain data form (ctx.storage.domain): schema-validated, event-emitting KV domains over storage backends for the Alego",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/storage/storage-domain"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/alego-storage": "workspace:*",
    "@singula-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@singula-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@singula-ai/alego-storage": "workspace:*",
    "@singula-ai/cordis": "workspace:~"
  }
}
