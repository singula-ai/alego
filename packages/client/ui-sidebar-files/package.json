{
  "name": "@singula-ai/alego-client-ui-sidebar-files",
  "description": "Workspace file tree tab type for the right Sidebar: lazy directory listing over the workspaceFiles Remote namespace, opening files into the Sidebar",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/client/ui-sidebar-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "alego": {
    "client": {
      "inject": [
        "@singula-ai/alego-api-workspace-files",
        "@singula-ai/alego-client-ui-sidebar-right",
        "@singula-ai/alego-client-ui-session",
        "@singula-ai/alego-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-api-remotes": "workspace:^",
    "@singula-ai/alego-api-workspace-files": "workspace:^",
    "@singula-ai/alego-client-locale": "workspace:^",
    "@singula-ai/alego-client-store": "workspace:^",
    "@singula-ai/alego-client-test-runtime": "workspace:^",
    "@singula-ai/alego-client-ui-dockkit": "workspace:^",
    "@singula-ai/alego-client-ui-primitives": "workspace:^",
    "@singula-ai/alego-client-ui-renderer": "workspace:^",
    "@singula-ai/alego-client-ui-session": "workspace:^",
    "@singula-ai/alego-client-ui-sidebar-right": "workspace:^",
    "@singula-ai/alego-client-ui-slots": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-util-workspace-path": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
