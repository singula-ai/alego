{
  "name": "@singula-ai/alego-client-ui-workspace",
  "description": "Workspace picker plugin: one WorkspacePicker registered into the sidebar and empty-state workspace slots",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/client/ui-workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "alego": {
    "client": {
      "inject": [
        "@singula-ai/alego-client-connection",
        "@singula-ai/alego-client-locale",
        "@singula-ai/alego-client-runtime",
        "@singula-ai/alego-client-ui-conversation",
        "@singula-ai/alego-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@singula-ai/alego-client-connection": "workspace:^",
    "@singula-ai/alego-client-locale": "workspace:^",
    "@singula-ai/alego-client-runtime": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-client-ui-conversation": "workspace:^",
    "@singula-ai/alego-client-ui-sidebar": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/alego-client-connection": "workspace:^",
    "@singula-ai/alego-client-locale": "workspace:^",
    "@singula-ai/alego-client-runtime": "workspace:^",
    "@singula-ai/alego-client-test-runtime": "workspace:^",
    "@singula-ai/alego-client-ui-conversation": "workspace:^",
    "@singula-ai/alego-client-ui-primitives": "workspace:^",
    "@singula-ai/alego-client-ui-sidebar": "workspace:^",
    "@singula-ai/alego-client-ui-slots": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@types/react": "~18.3.1",
    "@singula-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
