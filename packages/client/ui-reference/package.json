{
  "name": "@singula-ai/alego-client-ui-reference",
  "description": "Unified Web @file and @session reference source",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/client/ui-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "alego": {
    "client": {
      "inject": [
        "@singula-ai/alego-api-remotes",
        "@singula-ai/alego-api-session-controller",
        "@singula-ai/alego-client-connection",
        "@singula-ai/alego-client-locale",
        "@singula-ai/alego-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/alego-api-remotes": "workspace:^",
    "@singula-ai/alego-api-session-controller": "workspace:^",
    "@singula-ai/alego-client-connection": "workspace:^",
    "@singula-ai/alego-client-locale": "workspace:^",
    "@singula-ai/alego-client-test-runtime": "workspace:^",
    "@singula-ai/alego-client-ui-input-trigger": "workspace:^",
    "@singula-ai/alego-client-ui-primitives": "workspace:^",
    "@singula-ai/alego-client-ui-slots": "workspace:^",
    "@singula-ai/alego-file-reference": "workspace:^",
    "@singula-ai/alego-session-reference": "workspace:^",
    "@singula-ai/alego-typert-protocol": "workspace:^",
    "@singula-ai/alego-util-workspace-path": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
