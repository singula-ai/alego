{
  "name": "@singula-ai/alego-office-to-pdf",
  "description": "Shared Office-to-PDF conversion with bounded queues and caching",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/document/office-to-pdf"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/cordis-plugin-loader": "workspace:~",
    "@singula-ai/cordis-plugin-include": "workspace:~",
    "@singula-ai/alego-api-workspace-files": "workspace:*",
    "@singula-ai/alego-fs": "workspace:*",
    "@singula-ai/alego-session": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "^0.1.1",
    "@singula-ai/schemastery": "workspace:~",
    "@singula-ai/alego-brand": "workspace:*",
    "@singula-ai/alego-typert-protocol": "workspace:*",
    "zod": "^4.4.3"
  }
}
