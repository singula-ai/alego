{
  "name": "@singula-ai/alego-tool-present",
  "description": "Explicit workspace file delivery declarations for the Alego",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/fs/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@singula-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-fs": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-session-projection": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-fs": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-session-projection": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/alego-agent-loop": "workspace:^",
    "@singula-ai/alego-agent-loop-testkit": "workspace:^",
    "@singula-ai/alego-fs-local": "workspace:^",
    "@singula-ai/alego-system-prompt": "workspace:^",
    "@singula-ai/alego-scope": "workspace:^"
  }
}
