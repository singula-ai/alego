{
  "name": "@singula-ai/alego-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Alego filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@singula-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@singula-ai/alego-attachment": "workspace:^",
    "@singula-ai/alego-fs": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-sandbox": "workspace:^",
    "@singula-ai/alego-sandbox-policy": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-system-prompt": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/alego-user-approval": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-agent-loop": "workspace:^",
    "@singula-ai/alego-agent-loop-testkit": "workspace:^",
    "@singula-ai/alego-attachment": "workspace:^",
    "@singula-ai/alego-fs": "workspace:^",
    "@singula-ai/alego-fs-local": "workspace:^",
    "@singula-ai/alego-fs-observation-policy": "workspace:^",
    "@singula-ai/alego-invariants": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-llm-deepseek": "workspace:^",
    "@singula-ai/alego-sandbox": "workspace:^",
    "@singula-ai/alego-sandbox-policy": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-system-prompt": "workspace:^",
    "@singula-ai/alego-tools": "workspace:^",
    "@singula-ai/alego-user-approval": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  }
}
