{
  "name": "@alego/tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Alego filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@alego/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@alego/attachment": "workspace:^",
    "@alego/fs": "workspace:^",
    "@alego/invariants": "workspace:^",
    "@alego/llm": "workspace:^",
    "@alego/sandbox": "workspace:^",
    "@alego/sandbox-policy": "workspace:^",
    "@alego/session": "workspace:^",
    "@alego/system-prompt": "workspace:^",
    "@alego/tools": "workspace:^",
    "@alego/user-approval": "workspace:^",
    "@alego/cordis": "workspace:^"
  },
  "devDependencies": {
    "@alego/agent": "workspace:^",
    "@alego/agent-loop": "workspace:^",
    "@alego/agent-loop-testkit": "workspace:^",
    "@alego/attachment": "workspace:^",
    "@alego/fs": "workspace:^",
    "@alego/fs-local": "workspace:^",
    "@alego/fs-observation-policy": "workspace:^",
    "@alego/invariants": "workspace:^",
    "@alego/llm": "workspace:^",
    "@alego/llm-deepseek": "workspace:^",
    "@alego/sandbox": "workspace:^",
    "@alego/sandbox-policy": "workspace:^",
    "@alego/session": "workspace:^",
    "@alego/system-prompt": "workspace:^",
    "@alego/tools": "workspace:^",
    "@alego/user-approval": "workspace:^",
    "@alego/cordis": "workspace:^"
  }
}
