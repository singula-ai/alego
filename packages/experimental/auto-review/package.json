{
  "name": "@singula-ai/alego-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Alego Auto permission preset",
  "version": "0.1.7-rc.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-agent-instructions": "workspace:*",
    "@singula-ai/alego-llm": "workspace:*",
    "@singula-ai/alego-permission-presets": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-tools": "workspace:*",
    "@singula-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@singula-ai/alego-util-values": "workspace:*"
  },
  "devDependencies": {
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-agent-instructions": "workspace:*",
    "@singula-ai/alego-agent-loop": "workspace:*",
    "@singula-ai/alego-agent-loop-testkit": "workspace:*",
    "@singula-ai/alego-bash-sandbox": "workspace:*",
    "@singula-ai/alego-compaction": "workspace:*",
    "@singula-ai/alego-fs-local": "workspace:*",
    "@singula-ai/alego-fs-observation-policy": "workspace:*",
    "@singula-ai/alego-fs-sandbox": "workspace:*",
    "@singula-ai/alego-llm": "workspace:*",
    "@singula-ai/alego-llm-deepseek": "workspace:*",
    "@singula-ai/alego-llm-deepseek-api-key": "workspace:*",
    "@singula-ai/alego-permission-presets": "workspace:*",
    "@singula-ai/alego-ptc-runtime-node": "workspace:*",
    "@singula-ai/alego-sandbox": "workspace:*",
    "@singula-ai/alego-sandbox-policy": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-session-projection": "workspace:*",
    "@singula-ai/alego-shell": "workspace:*",
    "@singula-ai/alego-shell-env": "workspace:*",
    "@singula-ai/alego-subagent": "workspace:*",
    "@singula-ai/alego-subprocess-local": "workspace:*",
    "@singula-ai/alego-system-prompt": "workspace:*",
    "@singula-ai/alego-tool-bash": "workspace:*",
    "@singula-ai/alego-tool-fs": "workspace:*",
    "@singula-ai/alego-tool-subagent": "workspace:*",
    "@singula-ai/alego-tools": "workspace:*",
    "@singula-ai/alego-user-approval": "workspace:*",
    "@singula-ai/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "alego": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
