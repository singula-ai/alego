{
  "name": "@singula-ai/alego-experimental-worktree",
  "description": "Creates a named Git worktree and changes the calling Session working directory",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/experimental/worktree"
  },
  "dependencies": {
    "@singula-ai/schemastery": "workspace:~",
    "@singula-ai/alego-timeout": "workspace:*"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-fs": "workspace:*",
    "@singula-ai/alego-sandbox": "workspace:*",
    "@singula-ai/alego-sandbox-policy": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/alego-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-agent-loop-testkit": "workspace:*",
    "@singula-ai/alego-fs": "workspace:*",
    "@singula-ai/alego-fs-local": "workspace:*",
    "@singula-ai/alego-sandbox": "workspace:*",
    "@singula-ai/alego-sandbox-local": "workspace:*",
    "@singula-ai/alego-sandbox-policy": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-session-projection": "workspace:*",
    "@singula-ai/alego-subprocess": "workspace:*",
    "@singula-ai/alego-subprocess-local": "workspace:*",
    "@singula-ai/alego-system-prompt": "workspace:*",
    "@singula-ai/alego-working-directory": "workspace:*"
  }
}
