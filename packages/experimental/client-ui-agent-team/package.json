{
  "name": "@singula-ai/alego-experimental-client-ui-agent-team",
  "description": "Web Agent Teams roster, task board, and teammate navigation",
  "version": "0.1.3-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/experimental/client-ui-agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "alego": {
    "client": {
      "inject": [
        "@singula-ai/alego-api-remotes",
        "@singula-ai/alego-api-session-controller",
        "@singula-ai/alego-client-locale",
        "@singula-ai/alego-client-ui-conversation",
        "@singula-ai/alego-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@singula-ai/alego-api-remotes": "workspace:^",
    "@singula-ai/alego-api-session-controller": "workspace:^",
    "@singula-ai/alego-client-locale": "workspace:^",
    "@singula-ai/alego-client-ui-conversation": "workspace:^",
    "@singula-ai/alego-client-ui-primitives": "workspace:^",
    "@singula-ai/alego-client-ui-renderer": "workspace:^",
    "@singula-ai/alego-client-ui-session": "workspace:^",
    "@singula-ai/alego-client-ui-slots": "workspace:^",
    "@singula-ai/alego-experimental-agent-team": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-typert-protocol": "workspace:^",
    "@singula-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/alego-api-remotes": "workspace:^",
    "@singula-ai/alego-api-session-controller": "workspace:^",
    "@singula-ai/alego-client-locale": "workspace:^",
    "@singula-ai/alego-client-test-runtime": "workspace:^",
    "@singula-ai/alego-client-ui-conversation": "workspace:^",
    "@singula-ai/alego-client-ui-primitives": "workspace:^",
    "@singula-ai/alego-client-ui-renderer": "workspace:^",
    "@singula-ai/alego-client-ui-session": "workspace:^",
    "@singula-ai/alego-client-ui-slots": "workspace:^",
    "@singula-ai/alego-experimental-agent-team": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-typert-protocol": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@singula-ai/cordis": "workspace:^",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
