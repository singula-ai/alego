{
  "name": "@singula-ai/alego-otel",
  "description": "Cordis service for independent ordinary-event and byte-bounded Session-log OTLP channels",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/telemetry/otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/otlp-exporter-base": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/otlp-transformer": "0.222.0",
    "got": "^14.6.6"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-session": "workspace:*"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~",
    "@singula-ai/alego-session": "workspace:*"
  }
}
