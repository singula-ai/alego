{
  "name": "@singula-ai/alego-http-proxy",
  "description": "Process-wide outbound HTTP proxy policy for Alego: resolve it from the launch environment and install it as undici's global dispatcher",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/util/http-proxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:~"
  }
}
