{
  "name": "@singula-ai/alego-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Alego SDK clients",
  "version": "0.1.3-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@singula-ai/alego-brand": "workspace:^",
    "@singula-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-attachment": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-llm-deepseek": "workspace:^",
    "@singula-ai/alego-scope": "workspace:^",
    "@singula-ai/alego-sdk-protocol": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-subagent": "workspace:^"
  },
  "devDependencies": {
    "@singula-ai/cordis": "workspace:^",
    "@singula-ai/cordis-plugin-loader": "workspace:^",
    "@singula-ai/alego-agent": "workspace:^",
    "@singula-ai/alego-agent-loop": "workspace:^",
    "@singula-ai/alego-agent-loop-testkit": "workspace:^",
    "@singula-ai/alego-attachment": "workspace:^",
    "@singula-ai/alego-llm": "workspace:^",
    "@singula-ai/alego-llm-deepseek": "workspace:^",
    "@singula-ai/alego-scope": "workspace:^",
    "@singula-ai/alego-sdk-protocol": "workspace:^",
    "@singula-ai/alego-session": "workspace:^",
    "@singula-ai/alego-session-persistence-jsonl": "workspace:^",
    "@singula-ai/alego-session-projection": "workspace:^",
    "@singula-ai/alego-subagent": "workspace:^"
  }
}
