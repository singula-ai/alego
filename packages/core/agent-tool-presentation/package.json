{
  "name": "@singula-ai/alego-agent-tool-presentation",
  "description": "Agent-plane presentation selector: composes one agent's tools as PTC mode or native tool calls",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "packages/core/agent-tool-presentation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@singula-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@singula-ai/alego-tools": "workspace:*",
    "@singula-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@singula-ai/alego-agent": "workspace:*",
    "@singula-ai/alego-ptc-runtime": "workspace:*",
    "@singula-ai/alego-scope": "workspace:*",
    "@singula-ai/alego-session": "workspace:*",
    "@singula-ai/alego-system-prompt": "workspace:*",
    "@singula-ai/alego-tools": "workspace:*",
    "@singula-ai/cordis": "workspace:~"
  }
}
