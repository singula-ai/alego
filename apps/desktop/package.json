{
  "name": "@singula-ai/alego-desktop",
  "description": "Electron desktop shell for a bundled alego runtime and external plugins",
  "version": "0.2.1-rc.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "test:installer": "node scripts/test-windows-installer.mjs",
    "build": "tsc -b && pnpm run bundle",
    "bundle": "tsdown --config-loader native",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --skip-build",
    "test:updates:local": "pnpm run build && node scripts/test-local-updater.mjs",
    "prepare:runtime": "tsx scripts/prepare-runtime.ts",
    "render:tray-icon": "tsx scripts/render-tray-icon.ts",
    "prepare:primary-runtime": "tsx scripts/prepare-primary-runtime.ts",
    "sign:primary-runtime": "tsx scripts/sign-primary-runtime.ts",
    "cache:windows-signatures": "node scripts/manage-windows-signature-cache.mjs",
    "prepare:packages": "tsx scripts/prepare-package-set.ts",
    "prepare:alego": "tsx scripts/prepare-alego.ts",
    "prepare:package": "tsx scripts/package-target.ts --prepare-only",
    "verify:mac-signature": "node scripts/verify-macos-signature.mjs",
    "package": "tsx scripts/package-target.ts",
    "check:package": "tsx scripts/package-target.ts --check",
    "restore:mac-proxy": "tsx scripts/macos-notarization-proxy.ts",
    "package:dir": "tsx scripts/package-target.ts --dir",
    "package:mac:arm64": "tsx scripts/package-target.ts mac-arm64",
    "package:mac:arm64:unsigned": "tsx scripts/package-target.ts mac-arm64 --unsigned",
    "package:mac:arm64:dir": "tsx scripts/package-target.ts mac-arm64 --dir",
    "package:mac:x64": "tsx scripts/package-target.ts mac-x64",
    "package:mac:x64:unsigned": "tsx scripts/package-target.ts mac-x64 --unsigned",
    "package:mac:x64:dir": "tsx scripts/package-target.ts mac-x64 --dir",
    "package:win:x64": "tsx scripts/package-target.ts win-x64",
    "package:win:x64:unsigned": "tsx scripts/package-target.ts win-x64 --unsigned",
    "package:win:x64:dir": "tsx scripts/package-target.ts win-x64 --dir",
    "upload:mac:arm64": "tsx scripts/upload-target.ts mac-arm64",
    "upload:mac:x64": "tsx scripts/upload-target.ts mac-x64",
    "upload:win:x64": "tsx scripts/upload-target.ts win-x64",
    "upload:latest:mac:arm64": "tsx scripts/upload-target.ts mac-arm64 --latest",
    "upload:latest:mac:x64": "tsx scripts/upload-target.ts mac-x64 --latest",
    "upload:latest:win:x64": "tsx scripts/upload-target.ts win-x64 --latest"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "ws": "^8.21.3",
    "@singula-ai/alego-api-gateway": "workspace:*",
    "@singula-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@singula-ai/alego-app-boot": "workspace:*",
    "@singula-ai/alego-client-ui-settings-general": "workspace:*",
    "@singula-ai/alego-client-ui-sidebar-browser": "workspace:*",
    "@singula-ai/alego-home-paths": "workspace:*",
    "@singula-ai/node-addon-system": "workspace:~",
    "@electron/get": "^5.1.0",
    "@electron/notarize": "2.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/semver": "^7.8.0",
    "app-builder-lib": "26.17.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "extract-zip": "^2.0.1",
    "js-yaml": "^4.3.2",
    "koffi": "3.1.1",
    "pnpm": "11.28.5",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "@singula-ai/alego-deepseek-account": "workspace:*",
    "@types/ws": "^8.18.1",
    "@singula-ai/alego-client-ui-primitives": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.4.3",
    "@singula-ai/alego-client-ui-theme": "workspace:*",
    "@singula-ai/alego-client-shortcuts": "workspace:*",
    "@singula-ai/alego-atomic-write": "workspace:*",
    "@singula-ai/alego-client-product-analytics": "workspace:*"
  }
}
