# Copy to production.env and configure the production service before selecting this preset.
ALEGO_DESKTOP_APP_ID=dev.alego.desktop
ALEGO_DESKTOP_AUTO_UPDATE_ENV=production
ALEGO_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
ALEGO_DESKTOP_MACOS_PACK_CONCURRENCY=4
ALEGO_DESKTOP_MACOS_DOWNLOAD_PROXY=
ALEGO_DESKTOP_MACOS_NOTARIZATION_PROXY=
