{
  "name": "@singula-ai/alego-web-frontend",
  "description": "Web application entry: vite build over the @singula-ai/alego-client-web shell library; dist/ served by apps/cli's alego web",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singula-ai/alego.git",
    "directory": "apps/web"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/preview.html",
    "!dist/preview"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "build:preview": "pnpm --filter @singula-ai/alego-experimental-webworker-runtime exec tsdown && pnpm --filter @singula-ai/alego-experimental-webworker-packer exec tsdown && vite build && alego-pack-vfs-image --out dist/preview/vfs-image.tar.gz",
    "serve:preview": "http-server dist -a 0.0.0.0 -p 4173 -c-1"
  },
  "license": "MIT",
  "devDependencies": {
    "@singula-ai/cordis-plugin-group": "workspace:~",
    "@singula-ai/alego-client-modules": "workspace:*",
    "@singula-ai/alego-client-store": "workspace:*",
    "@singula-ai/alego-llm-mock-server": "workspace:*",
    "@singula-ai/alego-client-test-runtime": "workspace:*",
    "@singula-ai/alego-client-ui-deliverables": "workspace:*",
    "@singula-ai/alego-client-ui-dockkit": "workspace:*",
    "@singula-ai/alego-client-ui-primitives": "workspace:*",
    "@singula-ai/alego-client-ui-slots": "workspace:*",
    "@singula-ai/alego-client-web": "workspace:*",
    "@singula-ai/alego-cmdline": "workspace:*",
    "@singula-ai/alego-pwsh-local": "workspace:*",
    "@singula-ai/alego-experimental-agent-team": "workspace:*",
    "@singula-ai/alego-experimental-webworker-packer": "workspace:*",
    "@singula-ai/alego-experimental-webworker-runtime": "workspace:*",
    "@singula-ai/alego-remote-mock": "workspace:*",
    "@singula-ai/alego-session-projection-cache": "workspace:*",
    "@singula-ai/alego-util-values": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "8.21.3",
    "@singula-ai/alego-client-ui-theme": "workspace:*",
    "@singula-ai/alego-launch-environment": "workspace:*",
    "@singula-ai/alego-workspace-changes": "workspace:*",
    "@singula-ai/alego-subprocess-local": "workspace:*",
    "@singula-ai/alego-experimental-auto-review": "workspace:*",
    "@singula-ai/alego-experimental-speech-to-text": "workspace:*",
    "@singula-ai/alego-experimental-voice-input-bundle": "workspace:*",
    "@singula-ai/alego-experimental-cot-translation-bundle": "workspace:*",
    "@singula-ai/alego-experimental-worktree": "workspace:*",
    "@singula-ai/alego-experimental-plugin-market-bundle": "workspace:*"
  }
}
